FROM node:22-trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openjdk-21-jre-headless \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global firebase-tools@15.32.1

WORKDIR /workspace
EXPOSE 4000 8080 9099 9199
CMD ["firebase", "emulators:start", "--project", "demo-kufc", "--only", "auth,firestore,storage", "--import=/data", "--export-on-exit=/data"]
